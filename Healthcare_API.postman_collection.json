								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patient\": {{patient_id}},\n  \"doctor\": {{doctor_id}},\n  \"notes\": \"Assigned as primary diagnostic physician.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/mappings/",
							"host": ["{{base_url}}"],
							"path": ["api", "mappings", ""]
						},
						"description": "Assign a doctor to a patient."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.mapping) {",
									"        pm.collectionVariables.set('mapping_id', jsonData.mapping.id);",
